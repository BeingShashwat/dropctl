# Copy to `.env` and fill in for your deployment.

# Public origin of the deployed site. Drives canonical URLs, Open Graph tags,
# the robots.txt Sitemap line and sitemap.xml generation. No trailing slash.
#
# In development this may be left unset: canonical and Open Graph URLs then
# fall back to the live browser origin. It must be set for a production build,
# otherwise sitemap.xml is skipped.
VITE_SITE_URL=https://dropctl.example.com
